# Everything the image does not need at build or run time.

.git
.gitignore

# Raw CSV cache (~250 MB) and outputs: they arrive through the mounted data dir.
data

# Local virtualenv, if uv created one in the project.
.venv

# Credentials never enter an image.
.env
.env.*

__pycache__
*.py[cod]

# Module documentation and the hackathon brief are not runtime dependencies.
docs
tests
