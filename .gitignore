# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
__pycache__/
*.py[cod]
.venv/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# backend generated dossiers (local storage)
backend/app/storage/output/

# Token OAuth de Gmail (credencial local, nunca al repositorio)
backend/app/storage/secrets/

# Entorno virtual local y credenciales OAuth (nunca al repositorio)
venv/
client_secret*.json
**/client_secret*.json
*service-account*.json
backend/app/storage/secrets/
